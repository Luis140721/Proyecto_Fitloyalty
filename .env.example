# Sintaxis: docker compose --env-file .env ...
# Solo variables NO sensibles. Las sensibles (claves, passwords) se meten en
# el archivo .env de la maquina (NO commitear).

# --- Postgres ---
POSTGRES_USER=fitloyalty
POSTGRES_PASSWORD=fitlocal
POSTGRES_DB=fitloyalty
POSTGRES_PORT=5432

# --- Backend ---
NODE_ENV=production
PORT=3001
DATABASE_URL=postgres://fitloyalty:fitlocal@db:5432/fitloyalty
# OBLIGATORIA: el compose no arranca sin ella. Pon una clave larga y propia.
JWT_SECRET=cambia-esta-clave-en-prod-2026
JWT_EXPIRES_IN=7d
SUPPORT_EMAIL=fitloyaltysaas@gmail.com
SUPPORT_TRIAL_DAYS=7
# El Postgres del compose NO usa SSL. Neon/Render si lo requieren (DB_SSL=true).
DB_SSL=false

# --- Correo (Brevo API HTTPS) ---
# Sin BREVO_API_KEY los correos NO se envian: caen a modo consola (solo log).
# La key v3 empieza por xkeysib-
BREVO_API_KEY=
MAIL_FROM=FitLoyalty <fitloyaltysaas@gmail.com>
# Expone el codigo de recuperacion en la respuesta HTTP. Solo para demos.
SHOW_DEV_CODE_IN_UI=false

# --- Legacy: el codigo ya no lee estas. Se dejan por despliegues antiguos. ---
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Frontend ---
# Se inyecta al build de vite; cualquier ruta /api se proxea desde nginx al backend.
VITE_API_BASE=
FRONTEND_PORT=5173
