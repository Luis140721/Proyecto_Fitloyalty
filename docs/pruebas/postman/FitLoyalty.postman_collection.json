{
  "info": {
    "name": "FitLoyalty API · Casos de prueba T6",
    "description": "Casos CP-01 a CP-29 de docs/pruebas/matriz-casos-prueba.md. Correr en orden contra el ambiente de pruebas (docs/pruebas/plan-de-pruebas.md): cada corrida crea sus propios datos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 · Salud",
      "item": [
        {
          "name": "CP-01 · La API responde en /healthz",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Datos únicos de la corrida: la colección se puede repetir sin chocar.",
                  "const run = String(Date.now());",
                  "pm.collectionVariables.set('run', run);",
                  "pm.collectionVariables.set('emailA', `qa.a.${run}@example.test`);",
                  "pm.collectionVariables.set('emailB', `qa.b.${run}@example.test`);",
                  "pm.collectionVariables.set('docOk', `QA${run}`);",
                  "pm.collectionVariables.set('docVencido', `QV${run}`);",
                  "pm.collectionVariables.set('telOk', '3' + run.slice(-9));",
                  "const d = (n) => { const x = new Date(); x.setDate(x.getDate() + n); return x.toISOString().slice(0, 10); };",
                  "pm.collectionVariables.set('hoy', d(0));",
                  "pm.collectionVariables.set('en30', d(30));",
                  "pm.collectionVariables.set('hace60', d(-60));",
                  "pm.collectionVariables.set('hace30', d(-30));",
                  "pm.collectionVariables.set('ayer', d(-1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            }
          }
        }
      ]
    },
