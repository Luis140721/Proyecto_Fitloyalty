# ============================================================
# FITLOYALTY · .gitignore raíz del monorepo
# ============================================================

# --- Dependencias
node_modules/
**/node_modules/

# --- Build artifacts
dist/
build/
.next/
out/
**/dist/
**/build/

# --- Logs
*.log
*.log.*
*.err.log
*.out.log

# --- Variables de entorno (nunca se commitean)
.env
.env.local
.env.*.local
**/.env
**/.env.local

# --- Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.tmp

# --- Tests / coverage
coverage/
.nyc_output/

# --- Cache
.cache/
.parcel-cache/
.turbo/

# --- Archivos generados en pruebas E2E / locales (NO subir)
backend/signup*.json
backend/invited_token.txt
backend/.server*.log
backend/.gitignore_local
frontend/.vite.out.log
frontend/.vite.err.log

# --- Capturas de playwright / browser (NO subir)
*.png
**/*.png
.fitloyalty-*.png
.fitloyalty-*.jpg
kinetic-*.png
fitloyalty-*.png

# --- Carpetas de referencia de Stitch (referencia de diseño, no código)
stitch_fitloyalty_gesti_n_de_gimnasios/
stitch_*/

# --- Backend: artefactos locales de Postgres en desarrollo (si los hubiera)
backend/data/
backend/*.sqlite
backend/*.db

# --- Frontend: archivos generados por vite/React
frontend/coverage/
frontend/.vite/

# --- Servidor: PID / socket files
*.pid
*.sock

.vercel

# --- Carpeta .context/ del agente (workspace local, NO subir al repo)
.context/
**/.context/

# --- Logs y archivos locales de la raiz del proyecto (NO subir)
.backend.log
.seed.log
.vite-dev.log
.vite-preview.log
nul
*.tmp.json
*.out.json
render_*.json
login_*.json
clase_2_ui_*.html
render.exe
