# ============================================================
# FitLoyalty — Variables de entorno (plantilla)
# Copia este archivo a .env y rellena los valores reales.
# ============================================================

# --- App
NODE_ENV=development
PORT=3001

# --- Base de datos (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth / JWT
# Cambiar en produccion con `openssl rand -hex 64`
JWT_SECRET=cambia-esto-en-produccion-con-openssl-rand-hex-64
JWT_EXPIRES_IN=24h

# --- Trial
# Dias de prueba para cuentas nuevas (no aplica a cuentas en DEV_EMAILS)
TRIAL_DAYS=7

# --- Cuentas de desarrollo (separadas por coma)
# Estas cuentas se crean SIN trial al registrarse por /api/auth/signup.
# Ya tienen plan ilimitado. Usar SOLO en staging/dev.
DEV_EMAILS=dev@fitloyalty.local,staging@fitloyalty.local

# --- Resend (correos)
# API key desde https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Remitente. Sin dominio propio: 'FitLoyalty <onboarding@resend.dev>'
MAIL_FROM=FitLoyalty <onboarding@resend.dev>

# --- Brevo (correos)
# API key desde https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Remitente. Debe ser un correo verificado en Brevo
MAIL_FROM=FitLoyalty <onboarding@brevo.example>

# --- Front (public)
# URL del frontend para construir enlaces en correos
PUBLIC_FRONTEND_URL=https://fitloyalty-zeta.vercel.app
