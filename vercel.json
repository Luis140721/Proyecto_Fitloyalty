{
  "version": 2,
  "framework": "vite",
  "buildCommand": "cd frontend && npx --yes pnpm@12.15.0 run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npx --yes pnpm@12.15.0 install --frozen-lockfile",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
