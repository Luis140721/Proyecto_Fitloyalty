# Copia este archivo como assets/.env antes de construir la app.
# assets/.env no se sube al repositorio (esta en el .gitignore) y la app lo
# necesita para compilar (pubspec.yaml lo declara como asset).
#
# API_URL: URL de la API, con /api al final.
#   Produccion:                      https://fitloyalty-api.onrender.com/api
#   Emulador Android + backend local: http://10.0.2.2:3001/api
#   Celular por USB (adb reverse):    http://localhost:3001/api
API_URL=https://fitloyalty-api.onrender.com/api
APP_NAME=FitLoyalty
